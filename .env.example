# Copy file này thành .env và điền giá trị từ Supabase Dashboard (Settings → API).
# Không commit file .env lên Git.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Báo cáo crash (tuỳ chọn). Để trống = tắt hoàn toàn, app vẫn chạy bình thường.
# Lấy DSN từ Sentry Dashboard → Project Settings → Client Keys (DSN).
SENTRY_DSN=
# Nhãn môi trường hiển thị trong Sentry (production / staging / development).
APP_ENV=production

# Đăng nhập Google native (tuỳ chọn). Là *Web* client ID trong Google Cloud
# Console → APIs & Services → Credentials (cùng project với Android client).
# Để trống = nút Google dùng luồng trình duyệt qua Supabase.
# Xem docs/SOCIAL_AUTH_SETUP.md.
GOOGLE_WEB_CLIENT_ID=
